# /etc/lotto.env — konfiguracja SMTP dla lotto_run_and_mail.sh
# Skopiuj ten plik jako /etc/lotto.env i uzupelnij wartosci.
# Uprawnienia: sudo chmod 600 /etc/lotto.env
#              sudo chown root:pi /etc/lotto.env

# Serwer SMTP i port (587=STARTTLS, 465=SMTPS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Dane logowania do SMTP
SMTP_USER=lotto@example.com
SMTP_PASS=tajne_haslo

# Adres nadawcy (domyslnie: SMTP_USER jesli nie podany)
MAIL_FROM=lotto@example.com

# Adres odbiorcy — tu trafią powiadomienia
MAIL_TO=twoj_adres@example.com
